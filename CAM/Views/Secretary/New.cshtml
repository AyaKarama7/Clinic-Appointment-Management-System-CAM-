@using CAM.ViewModels
@model AppointmentCreateViewModel
@{
    ViewData["Title"] = "New Appointment";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-calendar-plus me-2"></i>New Appointment Booking
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="appointmentForm">

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="FirstName" class="form-label fw-semibold">First Name</label>
                                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Enter first name" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="LastName" class="form-label fw-semibold">Last Name</label>
                                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Enter last name" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="BirthDate" class="form-label fw-semibold">Date of Birth</label>
                                <input asp-for="BirthDate" type="date" class="form-control form-control-lg" required />
                                <span asp-validation-for="BirthDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="Phone" class="form-label fw-semibold">Phone Number</label>
                                <input asp-for="Phone" class="form-control form-control-lg" placeholder="Enter phone number" required />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>


                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label for="doctorSelect" class="form-label fw-semibold">Select Doctor</label>
                                <select asp-for="DoctorId" asp-items="ViewBag.Doctors" id="doctorSelect" class="form-select form-select-lg" required>
                                    <option value="">Choose a doctor...</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="datePicker" class="form-label fw-semibold">Appointment Date</label>
                                <input type="date" id="datePicker" class="form-control form-control-lg" required />
                            </div>
                            <div class="col-md-4">
                                <label for="VisitLengthMins" class="form-label fw-semibold">Duration (minutes)</label>
                                <input asp-for="VisitLengthMins" type="number" class="form-control form-control-lg" value="30" min="15" max="120" step="15" required />
                            </div>
                        </div>


                        <div class="mb-4">
                            <label class="form-label fw-semibold">Available Time Slots</label>
                            <div id="slotsContainer" class="border border-2 border-dashed border-secondary rounded p-4 text-center bg-light">
                                <p class="text-muted mb-0">Please select a doctor and date to view available slots</p>
                            </div>
                            <input type="hidden" asp-for="SlotStart" id="slotStart" required />
                        </div>


                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Book Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        
        document.getElementById('doctorSelect').addEventListener('change', loadSlots);
        document.getElementById('datePicker').addEventListener('change', loadSlots);
        document.querySelector('input[name="VisitLengthMins"]').addEventListener('change', loadSlots);

        async function loadSlots() {
            const doctorId = document.getElementById('doctorSelect').value;
            const date = document.getElementById('datePicker').value;
            const visitLength = document.querySelector('input[name="VisitLengthMins"]').value || 30;
            const container = document.getElementById('slotsContainer');

           
            document.getElementById('slotStart').value = '';

            if (!doctorId || !date) {
                container.innerHTML = '<p class="text-muted mb-0">Please select a doctor and date to view available slots</p>';
                return;
            }

      
            container.innerHTML = '<div class="d-flex justify-content-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div><p class="text-muted mt-2 mb-0">Loading available slots...</p>';

            try {
                const url = `/Secretary/GetFreeSlots?doctorId=${doctorId}&date=${date}&visitLength=${visitLength}`;
                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const slots = await response.json();
                container.innerHTML = '';

                if (slots.length === 0) {
                    container.innerHTML = '<p class="text-warning mb-0">No available slots for the selected date and duration.</p>';
                    return;
                }

                
                slots.forEach(slotIsoString => {
                    const slotDate = new Date(slotIsoString);
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-primary btn-sm m-1';
                    btn.textContent = slotDate.toLocaleTimeString([], {
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    });

                    btn.onclick = () => {
                        container.querySelectorAll('.btn').forEach(b => {
                            b.classList.remove('btn-primary');
                            b.classList.add('btn-outline-primary');
                        });

              
                        btn.classList.remove('btn-outline-primary');
                        btn.classList.add('btn-primary');

                        document.getElementById('slotStart').value = slotDate.toISOString();
                    };

                    container.appendChild(btn);
                });

            } catch (error) {
                console.error('Error loading slots:', error);
                container.innerHTML = '<p class="text-danger mb-0">Error loading slots. Please try again.</p>';
            }
        }
    </script>
}