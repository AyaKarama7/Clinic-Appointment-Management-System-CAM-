@{
    ViewData["Title"] = "Dashboard - CAM";
}

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h1 class="card-title display-5 fw-bold">
                                <i class="fas fa-hospital me-3"></i>Clinic Appointment Management
                            </h1>
                            <p class="card-text lead">Streamline your clinic's appointment scheduling and patient management</p>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="fas fa-calendar-check fa-5x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-plus fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">New Appointment</h5>
                    <p class="card-text text-muted">Schedule a new patient appointment</p>
                    <a href="@Url.Action("New", "Secretary")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Book Now
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-3x text-success mb-3"></i>
                    <h5 class="card-title">View Appointments</h5>
                    <p class="card-text text-muted">Manage today's appointments</p>
                    <a href="@Url.Action("List", "Secretary")" class="btn btn-success">
                        <i class="fas fa-eye me-2"></i>View All
                    </a>
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-users fa-2x text-info mb-2"></i>
                    <h3 class="text-info">24</h3>
                    <p class="text-muted small">Today's Appointments</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-user-md fa-2x text-primary mb-2"></i>
                    <h3 class="text-primary">5</h3>
                    <p class="text-muted small">Active Doctors</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                    <h3 class="text-warning">2</h3>
                    <p class="text-muted small">Available Slots</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                    <h3 class="text-success">18</h3>
                    <p class="text-muted small">Completed Today</p>
                </div>
            </div>
        </div>
    </div>
</div>