@model dynamic 
@{

    var isCreateActive = Model.CurrentView == "New";
    var isListActive = Model.CurrentView == "List";
}

<div class="mb-6 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <a href="@Url.Action("New", "Secretary")"
           class="py-3 px-1 border-b-4 font-medium text-sm focus:outline-none transition-colors duration-200
                  @(isCreateActive ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
            ➕ New Appointment
        </a>
        <a href="@Url.Action("List", "Secretary")"
           class="py-3 px-1 border-b-4 font-medium text-sm focus:outline-none transition-colors duration-200
                  @(isListActive ? "border-blue-600 text-blue-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300")">
            🗓️ View Appointments
        </a>
    </nav>
</div>